{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.4.1",
  "identifier": "app.otto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/fetch-model.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Otto",
        "url": "index.html",
        "width": 560,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "toasts",
        "title": "Otto tasks",
        "url": "toasts.html",
        "width": 380,
        "height": 10,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to Otto",
        "url": "onboarding.html",
        "width": 760,
        "height": 540,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "history",
        "title": "Otto",
        "url": "history.html",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../models/parakeet-tdt-0.6b-v2-Q8_0.gguf": "models/parakeet-tdt-0.6b-v2-Q8_0.gguf",
      "../models/silero-vad-v6.2-F32.gguf": "models/silero-vad-v6.2-F32.gguf",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-", "entitlements": "Entitlements.plist" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
